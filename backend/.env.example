# Ocean Explorer 3D — backend environment variables
# Copy this file to .env and adjust as needed. Nothing below is required to
# run the app; the Argovis API works without a key (see README for details).

# Free API key from https://argovis-keygen.colorado.edu/ — optional.
# Without it, requests to Argovis still work but may be throttled more
# aggressively under heavy load. Never commit a real key to git.
ARGOVIS_API_KEY=

# Comma-separated list of origins allowed to call this API in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upstream Argovis API base URL — official public Argo data service.
ARGOVIS_BASE_URL=https://argovis-api.colorado.edu

# How long (seconds) to cache upstream responses in memory.
CACHE_TTL_SECONDS=900
